# Corpus: se versiona el sintético v1 (~14k docs) bajo corpus_repo/corpus_v1/.
# No subir corpus de validación real ni derivados sensibles desde esta raíz (tienen su propio .gitignore dentro de corpus_repo).
corpus/
corpus_repo/real_validation_corpus/
corpus_repo/real_validation_set.json
# No usar *.txt global: bloquea fixtures de test (test/data/.../*.txt).
# Logs locales de ejecución bajo results/ (no métricas JSON)
results/**/*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Privacy evaluation results
privacy_evaluation_results/
*.json
!package.json
!tsconfig.json
# Excepciones: métricas versionadas y fixtures de tests (el patrón global *.json sigue ignorando el resto)
!results/**/*.json
!test/data/**/*.json
!corpus_repo/corpus_v1/**/*.json

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
activate_temp.bat
*.log

# Archived (suite docs, old backup; not needed to run suites)
_archive_suite_docs/
corpus_repo_old_backup/

# Bibliography / reference docs (local)
bibliography/

# Local archive (old suites; not part of the active tree — do not push)
restos/

