# Synthetic v1 corpus is tracked under corpus_repo/corpus_v1/.
# Real validation export at repo root policy (also see corpus_repo/.gitignore).
corpus/
corpus_repo/real_validation_corpus/
corpus_repo/real_validation_set.json
# Avoid a global *.txt rule: it hides test fixtures under test/data/**/*.txt.
# Local run logs under results/ (not metric JSON)
results/**/*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Privacy evaluation results
privacy_evaluation_results/
*.json
!package.json
!tsconfig.json
# Allow listed JSON trees only (global *.json hides everything else)
!results/**/*.json
!test/data/**/*.json
!corpus_repo/corpus_v1/**/*.json

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
activate_temp.bat
*.log

# Archived suite docs / old backup
_archive_suite_docs/
corpus_repo_old_backup/

# Bibliography / reference (local)
bibliography/

# Legacy suite snapshots (local only; do not push)
restos/

interpretacion/
